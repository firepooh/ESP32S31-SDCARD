# ESP32-S31-Korvo-1 (ESP32-S31-WROOM-3: 16 MB flash, 16 MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Console (logs + REPL) on UART0 = GPIO58/59, the on-board USB-to-UART Type-C port.
# The USB 2.0 Type-A port (High-Speed OTG) is used by the MSC device.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# PSRAM: large benchmark buffers (malloc > 16 KB may go to PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

# microSD: UHS-I SDR50 (100 MHz, 1.8 V signaling, 50 MB/s bus). The card accepts the 1.8 V
# switch only after a fresh power-up, so SD_CTRL (GPIO39, low = on) power-cycles it at boot.
# If the card refuses UHS-I the firmware falls back to High Speed 40 MHz.
CONFIG_BENCH_SD_SPEED_SDR50=y
CONFIG_BENCH_SD_UHS_LDO_CHAN=1
CONFIG_BENCH_SD_PWR_CTRL=y
CONFIG_BENCH_SD_PWR_GPIO=39
CONFIG_BENCH_SD_PWR_ON_LEVEL=0
CONFIG_BENCH_SD_PWR_OFF_MS=1000

# Performance
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_FREERTOS_HZ=1000

# FATFS (project copy in components/fatfs has exFAT enabled; exFAT needs long file names)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_VOLUME_COUNT=2
CONFIG_FATFS_PER_FILE_CACHE=y
CONFIG_FATFS_USE_DYN_BUFFERS=y
CONFIG_FATFS_ALLOC_PREFER_ALIGNED_WORK_BUFFERS=y
# SD cards use 512-byte sectors; keep FatFs in fixed 512-byte sector mode
CONFIG_WL_SECTOR_SIZE_512=y

# TinyUSB (esp_tinyusb): MSC on the High-Speed OTG port, DMA mode, 32 KB transfer buffer
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=32768
CONFIG_TINYUSB_MSC_MOUNT_PATH="/sdcard"
CONFIG_TINYUSB_MODE_DMA=y
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_TINYUSB_NET_MODE_NONE=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Espressif"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="S31 SD MSC Bench"
CONFIG_TINYUSB_DESC_SERIAL_STRING="S31SDMSC0001"
CONFIG_TINYUSB_DESC_MSC_STRING="S31 microSD"
